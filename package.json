{
  "name": "sonoriza",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source dynamic playlists shaped by your schedule, time and context.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:planner": "tsx --test src/services/playlist-planner/planner.test.ts",
    "test:spotify": "tsx --test src/services/spotify/*.test.ts",
    "test:incremental": "tsx --test src/jobs/*.test.ts",
    "test:simulation": "tsx --test src/services/simulation-presentation.test.ts src/services/configuration-readiness.test.ts",
    "test:lastfm": "tsx --test src/services/lastfm/*.test.ts",
    "test:history": "tsx --test src/services/listening-history/*.test.ts",
    "test:music-preference": "tsx --test src/services/music-preference/*.test.ts",
    "test:discovery": "tsx --test src/services/music-discovery/*.test.ts",
    "test:spotify-history": "tsx --test src/services/spotify-extended-history/*.test.ts",
    "history:lastfm": "tsx scripts/import-lastfm-history.ts",
    "history:spotify": "tsx scripts/import-spotify-extended-history.ts",
    "discovery:profile": "tsx scripts/report-music-discovery-profile.ts",
    "discovery:score": "tsx scripts/report-music-discovery-score.ts",
    "discovery:planner-preview": "tsx scripts/report-music-discovery-planner-preview.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "generate:run": "tsx scripts/run-generation.ts",
    "plan:example": "tsx scripts/plan-example.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.2.1",
    "next": "^15.1.4",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
