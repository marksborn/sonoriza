# ---------------------------------------------------------------------------
# Sonoriza — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://sonoriza:password@localhost:5432/sonoriza?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Base URL of the deployed app (used for OAuth callbacks).
AUTH_URL="http://localhost:3000"
# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Access allowlist. In production this is fail-closed: if the variable is empty
# or missing, no email may authenticate. Separate entries with commas, spaces,
# semicolons or line breaks. Values are normalized to lowercase.
SONORIZA_ALLOWED_EMAILS="owner@example.com"

# ---------------------------------------------------------------------------
# Spotify OAuth — https://developer.spotify.com/dashboard
# Redirect URI: ${AUTH_URL}/api/auth/callback/spotify
# ---------------------------------------------------------------------------
AUTH_SPOTIFY_ID=""
AUTH_SPOTIFY_SECRET=""

# ---------------------------------------------------------------------------
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: ${AUTH_URL}/api/auth/callback/google
# Enable the "Google Calendar API" for the project.
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Scheduled generation
# ---------------------------------------------------------------------------
# Shared secret required by POST /api/cron/generate. The server cron sends it
# as `Authorization: Bearer <CRON_SECRET>`. Generate with: openssl rand -hex 32
CRON_SECRET="change-me"