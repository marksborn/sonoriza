# ---------------------------------------------------------------------------
# Sonoriza — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://sonoriza:password@localhost:5432/sonoriza?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Base URL of the deployed app (used for OAuth callbacks).
AUTH_URL="http://localhost:3000"
# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me"

# AUTH-01 restricted beta access. Accepts comma and/or line separated emails;
# matching is trim + lowercase. In production, an absent/empty list authorizes
# nobody (fail closed). Development/test remain open only while this variable is
# absent, so local onboarding does not require a personal email in source code.
SONORIZA_ALLOWED_EMAILS="owner@example.com,tester@example.com"

# ---------------------------------------------------------------------------
# Spotify OAuth — https://developer.spotify.com/dashboard
# Redirect URI: ${AUTH_URL}/api/auth/callback/spotify
# ---------------------------------------------------------------------------
AUTH_SPOTIFY_ID=""
AUTH_SPOTIFY_SECRET=""

# ALBUM-UI background snapshot refresh is quota-bounded per user and resumable
# through the persistent catalog cache. Keep this explicit in production even
# though the code also defaults conservatively to 4 requests per refresh.
ALBUM_OPPORTUNITY_SPOTIFY_REQUEST_BUDGET="4"
# Optional filesystem overrides. When omitted, both caches live below
# ~/.sonoriza-cache for the process user.
# SPOTIFY_CATALOG_CACHE_DIR="/path/to/spotify-catalog"
# ALBUM_OPPORTUNITY_SNAPSHOT_DIR="/path/to/album-opportunity"

# ---------------------------------------------------------------------------
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: ${AUTH_URL}/api/auth/callback/google
# Enable the "Google Calendar API" for the project.
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# HISTORY-01 / MUSIC-06 — Last.fm read-only access
# ---------------------------------------------------------------------------
# Create an API account/key at Last.fm. user.getRecentTracks/user.getInfo do
# not require an authenticated Last.fm session for public listening history.
# Do not put a Last.fm API secret here: Sonoriza does not use Last.fm writes.
LASTFM_API_KEY=""
LASTFM_USERNAME=""

# MUSIC-06 Gate 5B productive bounded rerank. Deployment alone does NOT enable
# this path. Both the master flag and exact normalized user-email allowlist are
# required before any Gate 5B Last.fm provider read or planner influence.
# The approved capability only changes recommendation/rank order; inferred
# Last.fm behavior never hard-excludes candidates or changes eligibility.
MUSIC_06_LASTFM_PLANNER_ENABLED="false"
MUSIC_06_LASTFM_PLANNER_USER_EMAILS=""

# MUSIC-07 eligibility anchor. OFF is the safe default. SHADOW derives
# SONORIZA_EXPOSURE anchors but never removes candidates. ACTIVE requires an
# exact user-email allowlist match.
#
# #343 rollout scope is explicit. Missing/blank SCOPE deliberately preserves
# legacy ALLOWLIST behavior; an empty TARGET_IDS list never means GLOBAL.
# GLOBAL must be explicitly selected. Under ACTIVE + GLOBAL, productive blocked
# sets remain isolated by targetPlaylistId and the legacy shared filter stays
# empty; TARGET_IDS is only used by ALLOWLIST compatibility mode.
MUSIC_07_ELIGIBILITY_MODE="OFF"
MUSIC_07_ELIGIBILITY_SCOPE="ALLOWLIST"
MUSIC_07_ELIGIBILITY_EMAIL_ALLOWLIST=""
MUSIC_07_ELIGIBILITY_TARGET_IDS=""

# PLAYBACK-RESERVE-01 Gate 7 controlled productive rollout. SHADOW is the safe
# default and keeps Gates 3-6 behavior only. ACTIVE never means global: an exact
# targetPlaylistId allowlist is mandatory; ACTIVE with an empty allowlist falls
# back to SHADOW. Productive reserve is limited to full generation/REBUILD_DAILY
# in Gate 7; KEEP_FILLED remains deferred to Gate 8. A current quality-approved
# simulation with the same configuration fingerprint and reserve projection is
# mandatory before any RESERVE suffix can be appended to Spotify.
PLAYBACK_RESERVE_RUNTIME_MODE="SHADOW"
PLAYBACK_RESERVE_ACTIVE_TARGET_IDS=""

# ---------------------------------------------------------------------------
# Scheduled generation
# ---------------------------------------------------------------------------
# Shared secret required by POST /api/cron/generate. The server cron sends it
# as `Authorization: Bearer <CRON_SECRET>`. Generate one with: openssl rand -hex 32
CRON_SECRET="change-me"

# ---------------------------------------------------------------------------
# NOTIFY-01 — Web Push / VAPID
# ---------------------------------------------------------------------------
# Generate this key pair once with `npx web-push generate-vapid-keys --json`.
# The public key may be sent to authenticated browsers. The private key must
# stay only in the server environment and must never be committed or logged.
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
# VAPID contact identifier. Prefer an operational mailbox for production.
WEB_PUSH_VAPID_SUBJECT="mailto:admin@example.com"
