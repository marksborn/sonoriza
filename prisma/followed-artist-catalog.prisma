// ---------------------------------------------------------------------------
// DISCOVERY-FOLLOWED-01 (#564) Gate C — per-user sampled catalog of followed
// artists. The follow list only bounds the catalog (PERSONAL §8.1); it is not
// taste evidence. Read-only provider data: no planner influence in Gate C.
// ---------------------------------------------------------------------------

model FollowedArtistCatalogSnapshot {
  userId           String   @id
  fetchedAt        DateTime
  followedSyncedAt DateTime
  followedCount    Int
  candidateCount   Int
  /// {id, name}[] of followed artists at the last weekly sync.
  followedArtists  Json
  /// Per artist: checkedAt, nextOffset and sampledAlbumIds (rotation state).
  artistChecks     Json
  /// Accumulated candidate tracks with reasons (see followed-catalog.ts).
  candidates       Json
  /// Provider counters, failures and exclusions by reason.
  evidence         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
