// Sonoriza — Prisma schema
// PostgreSQL + Prisma. The generation engine is decoupled from these models:
// it consumes plain domain types (see src/services/playlist-planner/types.ts)
// and only the orchestration layer reads/writes these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) — application authentication + linked OAuth providers.
// A single User links one Account row per provider (spotify, google). The
// Account rows hold the access/refresh tokens the engine uses to call the
// Spotify Web API and the Google Calendar API from the scheduled job.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  calendarSelections CalendarSelection[]
  sourcePlaylists    SourcePlaylist[]
  targetPlaylists    TargetPlaylist[]
  generationRuns     GenerationRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "spotify" | "google"
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Google Calendar — which calendars are consulted and which ones may
// contribute event duration to calendar-based target playlists.
// ---------------------------------------------------------------------------

model CalendarSelection {
  id               String   @id @default(cuid())
  userId           String
  googleCalendarId String
  summary          String?
  // Consulted at all when resolving calendar-based durations.
  selected         Boolean  @default(true)
  // Timed events on this calendar may contribute to calendar-based duration.
  usedForDuration     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleCalendarId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Source content — Spotify playlists (music), shows and the user's native
// "Your Episodes" library that supply candidates to the planner.
// ---------------------------------------------------------------------------

enum SourceKind {
  MUSIC
  PODCAST
}

enum SpotifySourceType {
  PLAYLIST
  SHOW
  SAVED_EPISODES
}

enum PodcastEpisodeOrder {
  SOURCE_DEFAULT
  OLDEST_FIRST
  NEWEST_FIRST
}

model SourcePlaylist {
  id            String            @id @default(cuid())
  userId        String
  kind          SourceKind
  spotifyType   SpotifySourceType
  spotifyId     String
  name          String?
  enabled       Boolean           @default(true)
  // Podcast sources exclude fully played episodes by default. When enabled,
  // fully played episodes can be selected again and use their full duration.
  includePlayed Boolean           @default(false)
  // SHOW-only ordering policy. Existing rows preserve provider/default order.
  episodeOrder  PodcastEpisodeOrder @default(SOURCE_DEFAULT)
  // Playlist cache is currently used only for MUSIC sources. Podcast playback
  // state remains live because resume_point can change without a playlist edit.
  spotifySnapshotId String?
  cachedCandidates  Json?
  cacheUpdatedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyType, spotifyId])
  @@index([userId, kind])
}

// ---------------------------------------------------------------------------
// Target playlists — the destinations that get (re)built on each run.
// Priority defines generation order: lower runs first and reserves its
// content, so later playlists only see what is left (cross-playlist
// exclusivity within a single run).
// ---------------------------------------------------------------------------

enum DurationMode {
  FIXED // fixedDurationSeconds
  CALENDAR // sum of eligible timed calendar events for the day
}

enum EmptyCalendarBehavior {
  CLEAR // empty the playlist when there are no eligible events
  KEEP // leave the previous contents untouched
  SKIP // do not touch the playlist at all this run
}

enum CalendarEventFilterMode {
  ALL // every timed event on calendars enabled for duration
  MARKER // only timed events whose title/description contains calendarEventMarker
}

enum PodcastEpisodeMaxDurationMode {
  NONE
  FIXED
  CALENDAR_MAX_EVENT
}

enum CompositionMode {
  PROPORTION
  SEQUENCE
}

model TargetPlaylist {
  id                              String                        @id @default(cuid())
  userId                          String
  name                            String
  spotifyPlaylistId               String? // set once the playlist exists on Spotify
  enabled                         Boolean                       @default(true)
  // Lower value is generated first and reserves its content.
  priority                        Int                           @default(0)
  // Existing destinations migrate safely to proportion semantics.
  compositionMode                 CompositionMode               @default(PROPORTION)

  durationMode                    DurationMode                  @default(FIXED)
  fixedDurationSeconds            Int? // required when durationMode = FIXED
  emptyCalendarBehavior           EmptyCalendarBehavior         @default(CLEAR)
  calendarEventFilterMode         CalendarEventFilterMode       @default(ALL)
  calendarEventMarker             String?

  // Proportion between podcasts and music. musicPercent = 100 - podcastPercent.
  podcastPercent                  Int                           @default(60)
  podcastEpisodeMaxDurationMode   PodcastEpisodeMaxDurationMode @default(NONE)
  podcastEpisodeMaxDurationSeconds Int?

  // Cyclic play sequence, e.g. ["MUSIC","PODCAST","MUSIC","MUSIC","PODCAST"].
  sequencePattern                 Json

  // Cap of episodes per program (Spotify show) inside this playlist.
  maxEpisodesPerProgram           Int                           @default(1)

  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationItems GenerationItem[]

  @@index([userId, priority])
}

// ---------------------------------------------------------------------------
// Generation runs — history, results and errors of each execution.
// ---------------------------------------------------------------------------

enum RunTrigger {
  MANUAL
  SCHEDULED
  SIMULATION
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL // some target playlists succeeded, others failed
  FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model GenerationRun {
  id         String     @id @default(cuid())
  userId     String
  trigger    RunTrigger
  // Simulation runs never write to Spotify.
  simulation Boolean    @default(false)
  status     RunStatus  @default(PENDING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  error      String?    @db.Text
  // Free-form structured summary (per-playlist counts, durations, skips...).
  summary    Json?

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs  GenerationLog[]
  items GenerationItem[]

  @@index([userId, startedAt])
}

model GenerationLog {
  id        String   @id @default(cuid())
  runId     String
  level     LogLevel @default(INFO)
  message   String   @db.Text
  data      Json?
  createdAt DateTime @default(now())

  run GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

enum ContentType {
  MUSIC
  PODCAST
}

model GenerationItem {
  id               String      @id @default(cuid())
  runId            String
  targetPlaylistId String
  position         Int
  contentType      ContentType
  // Spotify URI, e.g. "spotify:track:..." or "spotify:episode:...".
  spotifyUri       String
  title            String?
  // Track artist(s) or, for episodes, the show (program) name.
  subtitle         String?
  // Spotify show id for episodes — used to enforce max episodes per program.
  programId        String?
  // Effective listening duration used by the planner. For a partially played
  // podcast this is the remaining duration, not necessarily its catalog length.
  durationMs       Int         @default(0)

  run    GenerationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  target TargetPlaylist @relation(fields: [targetPlaylistId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([targetPlaylistId])
}
