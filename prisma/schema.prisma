// Sonoriza — Prisma schema
// PostgreSQL + Prisma. The generation engine is decoupled from these models:
// it consumes plain domain types (see src/services/playlist-planner/types.ts)
// and only the orchestration layer reads/writes these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) — application authentication + linked OAuth providers.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  calendarSelections     CalendarSelection[]
  sourcePlaylists        SourcePlaylist[]
  targetPlaylists        TargetPlaylist[]
  generationRuns         GenerationRun[]
  musicPlaybackPolicy    MusicPlaybackPolicy?
  trackListeningStates   TrackListeningState[]
  episodeListeningStates EpisodeListeningState[]
  musicSourceCleanupRuns MusicSourceCleanupRun[]
  musicIngestionRules    MusicIngestionRule[]
  musicIngestionRuns     MusicIngestionRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Google Calendar
// ---------------------------------------------------------------------------

model CalendarSelection {
  id               String   @id @default(cuid())
  userId           String
  googleCalendarId String
  summary          String?
  selected         Boolean  @default(true)
  usedForDuration  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleCalendarId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Source content
// ---------------------------------------------------------------------------

enum SourceKind {
  MUSIC
  PODCAST
}

enum SpotifySourceType {
  PLAYLIST
  SHOW
  SAVED_EPISODES
}

enum PodcastEpisodeOrder {
  SOURCE_DEFAULT
  OLDEST_FIRST
  NEWEST_FIRST
}

enum MusicSourceRetentionMode {
  KEEP_ALL
  REMOVE_AFTER_PLAYED
}

enum MusicSourceCleanupStatus {
  PREVIEW
  SUCCESS
  PARTIAL
  FAILED
  STALE
}

model SourcePlaylist {
  id            String              @id @default(cuid())
  userId        String
  kind          SourceKind
  spotifyType   SpotifySourceType
  spotifyId     String
  name          String?
  enabled       Boolean             @default(true)
  includePlayed Boolean             @default(false)
  episodeOrder  PodcastEpisodeOrder @default(SOURCE_DEFAULT)

  spotifySnapshotId String?
  cachedCandidates  Json?
  cacheUpdatedAt    DateTime?

  musicRetentionMode            MusicSourceRetentionMode @default(KEEP_ALL)
  musicCleanupAutomationEnabled Boolean                  @default(false)
  musicCleanupFirstCompletedAt  DateTime?
  musicCleanupLastRunAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cleanupRuns          MusicSourceCleanupRun[]
  ingestionRulesTarget MusicIngestionRule[]    @relation("MusicIngestionTarget")
  ingestionRunsTarget  MusicIngestionRun[]     @relation("MusicIngestionRunTarget")

  @@unique([userId, spotifyType, spotifyId])
  @@index([userId, kind])
}

model MusicSourceCleanupRun {
  id                     String                   @id @default(cuid())
  userId                 String
  sourcePlaylistId       String
  status                 MusicSourceCleanupStatus @default(PREVIEW)
  snapshotBefore         String
  snapshotAfter          String?
  planHash               String
  examinedCount          Int
  removableTrackCount    Int
  removalOccurrenceCount Int
  keptCount              Int
  plannedUris            Json
  removedUris            Json?
  failedUris             Json?
  startedAt              DateTime                 @default(now())
  finishedAt             DateTime?
  error                  String?                  @db.Text

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  source SourcePlaylist @relation(fields: [sourcePlaylistId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([sourcePlaylistId, startedAt])
}

// ---------------------------------------------------------------------------
// MUSIC-03 — playlist-inbox ingestion rules and audit history.
// ---------------------------------------------------------------------------

enum MusicIngestionRuleType {
  PLAYLIST_COPY
  SAVED_TRACK
  SAVED_TRACK_ALBUM
}

enum MusicIngestionInitialMode {
  FROM_NOW
  IMPORT_CURRENT
}

enum MusicIngestionCapabilityStatus {
  UNKNOWN
  SUPPORTED
  BLOCKED
}

enum MusicIngestionTrigger {
  INITIAL_BASELINE
  INITIAL_IMPORT
  USER_SYNC
  SCHEDULED
  MANUAL
}

enum MusicIngestionRunStatus {
  PREVIEW
  SUCCESS
  PARTIAL
  FAILED
  NOOP
}

model MusicIngestionRule {
  id                     String                         @id @default(cuid())
  userId                 String
  targetSourcePlaylistId String
  type                   MusicIngestionRuleType
  sourceSpotifyId        String?
  sourceName             String?
  enabled                Boolean                        @default(false)
  initialMode            MusicIngestionInitialMode      @default(FROM_NOW)
  state                  Json?
  capabilityStatus       MusicIngestionCapabilityStatus @default(UNKNOWN)
  capabilityMessage      String?                        @db.Text
  lastSyncAt             DateTime?
  lastSuccessAt          DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  target SourcePlaylist      @relation("MusicIngestionTarget", fields: [targetSourcePlaylistId], references: [id], onDelete: Cascade)
  runs   MusicIngestionRun[]

  @@index([userId, enabled])
  @@index([targetSourcePlaylistId])
}

model MusicIngestionRun {
  id                     String                  @id @default(cuid())
  userId                 String
  ruleId                 String?
  targetSourcePlaylistId String
  ruleType               MusicIngestionRuleType?
  trigger                MusicIngestionTrigger
  status                 MusicIngestionRunStatus
  preview                Boolean                 @default(false)
  sourceEventCount       Int                     @default(0)
  addedCount             Int                     @default(0)
  duplicateCount         Int                     @default(0)
  cooldownCount          Int                     @default(0)
  unavailableCount       Int                     @default(0)
  details                Json?
  startedAt              DateTime                @default(now())
  finishedAt             DateTime?
  error                  String?                 @db.Text

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule   MusicIngestionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  target SourcePlaylist      @relation("MusicIngestionRunTarget", fields: [targetSourcePlaylistId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([ruleId, startedAt])
  @@index([targetSourcePlaylistId, startedAt])
}

// ---------------------------------------------------------------------------
// Native music listening history — MUSIC-01
// ---------------------------------------------------------------------------

enum MusicRepeatWindowUnit {
  DAYS
  MONTHS
  YEARS
}

model MusicPlaybackPolicy {
  id                String                 @id @default(cuid())
  userId            String                 @unique
  enabled           Boolean                @default(false)
  windowValue       Int?
  windowUnit        MusicRepeatWindowUnit?
  historyKnownSince DateTime?
  lastSyncAt        DateTime?
  syncAfterCursor   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrackListeningState {
  id             String   @id @default(cuid())
  userId         String
  spotifyTrackId String
  spotifyUri     String?
  lastPlayedAt   DateTime
  firstSeenAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyTrackId])
  @@index([userId, lastPlayedAt])
}

// ---------------------------------------------------------------------------
// Native podcast listening state — PODCAST-04.
// ---------------------------------------------------------------------------

enum PodcastListeningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model EpisodeListeningState {
  id               String                 @id @default(cuid())
  userId           String
  spotifyEpisodeId String
  spotifyUri       String
  durationMs       Int
  resumePositionMs Int                    @default(0)
  fullyPlayed      Boolean                @default(false)
  status           PodcastListeningStatus @default(NOT_STARTED)
  lastObservedAt   DateTime
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyEpisodeId])
  @@index([userId, status])
  @@index([userId, lastObservedAt])
}

// ---------------------------------------------------------------------------
// Target playlists
// ---------------------------------------------------------------------------

enum DurationMode {
  FIXED
  CALENDAR
}

enum EmptyCalendarBehavior {
  CLEAR
  KEEP
  SKIP
}

enum CalendarEventFilterMode {
  ALL
  MARKER
}

enum PodcastEpisodeMaxDurationMode {
  NONE
  FIXED
  CALENDAR_MAX_EVENT
}

enum CompositionMode {
  PROPORTION
  SEQUENCE
}

enum MusicOrderMode {
  STANDARD
  RANDOMIZED
}

model TargetPlaylist {
  id                               String                        @id @default(cuid())
  userId                           String
  name                             String
  spotifyPlaylistId                String?
  enabled                          Boolean                       @default(true)
  priority                         Int                           @default(0)
  compositionMode                  CompositionMode               @default(PROPORTION)
  musicOrderMode                   MusicOrderMode                @default(STANDARD)
  durationMode                     DurationMode                  @default(FIXED)
  fixedDurationSeconds             Int?
  emptyCalendarBehavior            EmptyCalendarBehavior         @default(CLEAR)
  calendarEventFilterMode          CalendarEventFilterMode       @default(ALL)
  calendarEventMarker              String?
  podcastPercent                   Int                           @default(60)
  podcastEpisodeMaxDurationMode    PodcastEpisodeMaxDurationMode @default(NONE)
  podcastEpisodeMaxDurationSeconds Int?
  sequencePattern                  Json
  maxEpisodesPerProgram            Int                           @default(1)
  maxTracksPerArtist               Int?
  maxTracksPerAlbum                Int?
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationItems GenerationItem[]

  @@index([userId, priority])
}

// ---------------------------------------------------------------------------
// Generation runs
// ---------------------------------------------------------------------------

enum RunTrigger {
  MANUAL
  SCHEDULED
  SIMULATION
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model GenerationRun {
  id         String     @id @default(cuid())
  userId     String
  trigger    RunTrigger
  simulation Boolean    @default(false)
  status     RunStatus  @default(PENDING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  error      String?    @db.Text
  summary    Json?

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs  GenerationLog[]
  items GenerationItem[]

  @@index([userId, startedAt])
}

model GenerationLog {
  id        String   @id @default(cuid())
  runId     String
  level     LogLevel @default(INFO)
  message   String   @db.Text
  data      Json?
  createdAt DateTime @default(now())

  run GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

enum ContentType {
  MUSIC
  PODCAST
}

model GenerationItem {
  id               String      @id @default(cuid())
  runId            String
  targetPlaylistId String
  position         Int
  contentType      ContentType
  spotifyUri       String
  title            String?
  subtitle         String?
  programId        String?
  durationMs       Int         @default(0)

  run    GenerationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  target TargetPlaylist @relation(fields: [targetPlaylistId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([targetPlaylistId])
}
