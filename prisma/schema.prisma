// Sonoriza — Prisma schema
// PostgreSQL + Prisma. The generation engine is decoupled from these models:
// it consumes plain domain types (see src/services/playlist-planner/types.ts)
// and only the orchestration layer reads/writes these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) — application authentication + linked OAuth providers.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                         Account[]
  sessions                         Session[]
  calendarSelections               CalendarSelection[]
  sourcePlaylists                  SourcePlaylist[]
  targetPlaylists                  TargetPlaylist[]
  generationRuns                   GenerationRun[]
  musicPlaybackPolicy              MusicPlaybackPolicy?
  trackListeningStates             TrackListeningState[]
  trackListeningEvents             TrackListeningEvent[]
  lastFmBackfillRuns               LastFmBackfillRun[]
  spotifyExtendedHistoryImportRuns SpotifyExtendedHistoryImportRun[]
  episodeListeningStates           EpisodeListeningState[]
  musicSourceCleanupRuns           MusicSourceCleanupRun[]
  musicIngestionRules              MusicIngestionRule[]
  musicIngestionRuns               MusicIngestionRun[]
  targetScheduleRuns               TargetScheduleRun[]
  notificationPreference           NotificationPreference?
  pushSubscriptions                PushSubscription[]
  pushDeliveries                   PushDelivery[]
  musicPreferenceSignals           MusicPreferenceSignal[]
  likedTrackPreferences            LikedTrackPreference[]
  nativeSourcePreferences          NativeSourcePreference[]
  artistAffinityStates             ArtistAffinityState[]
  artistSimilaritySeeds            ArtistSimilaritySeedState[]
  artistSimilarityEdges            ArtistSimilarityEdge[]
  albumRecommendationMemories      AlbumRecommendationMemory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Google Calendar
// ---------------------------------------------------------------------------

model CalendarSelection {
  id               String   @id @default(cuid())
  userId           String
  googleCalendarId String
  summary          String?
  selected         Boolean  @default(true)
  usedForDuration  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetPlaylistCalendars TargetPlaylistCalendar[]

  @@unique([userId, googleCalendarId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Source content
// ---------------------------------------------------------------------------

enum SourceKind {
  MUSIC
  PODCAST
}

enum SpotifySourceType {
  PLAYLIST
  SHOW
  SAVED_EPISODES
}

enum PodcastEpisodeOrder {
  SOURCE_DEFAULT
  OLDEST_FIRST
  NEWEST_FIRST
}

enum MusicSourceRetentionMode {
  KEEP_ALL
  REMOVE_AFTER_PLAYED
}

enum MusicSourceCleanupStatus {
  PREVIEW
  SUCCESS
  PARTIAL
  FAILED
  STALE
}

model SourcePlaylist {
  id            String              @id @default(cuid())
  userId        String
  kind          SourceKind
  spotifyType   SpotifySourceType
  spotifyId     String
  name          String?
  enabled       Boolean             @default(true)
  includePlayed Boolean             @default(false)
  episodeOrder  PodcastEpisodeOrder @default(SOURCE_DEFAULT)

  spotifySnapshotId String?
  cachedCandidates  Json?
  cacheUpdatedAt    DateTime?

  musicRetentionMode            MusicSourceRetentionMode @default(KEEP_ALL)
  musicCleanupAutomationEnabled Boolean                  @default(false)
  musicCleanupFirstCompletedAt  DateTime?
  musicCleanupLastRunAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cleanupRuns          MusicSourceCleanupRun[]
  ingestionRulesTarget MusicIngestionRule[]    @relation("MusicIngestionTarget")
  ingestionRunsTarget  MusicIngestionRun[]     @relation("MusicIngestionRunTarget")

  @@unique([userId, spotifyType, spotifyId])
  @@index([userId, kind])
}

model MusicSourceCleanupRun {
  id                     String                   @id @default(cuid())
  userId                 String
  sourcePlaylistId       String
  status                 MusicSourceCleanupStatus @default(PREVIEW)
  snapshotBefore         String
  snapshotAfter          String?
  planHash               String
  examinedCount          Int
  removableTrackCount    Int
  removalOccurrenceCount Int
  keptCount              Int
  plannedUris            Json
  removedUris            Json?
  failedUris             Json?
  startedAt              DateTime                 @default(now())
  finishedAt             DateTime?
  error                  String?                  @db.Text

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  source SourcePlaylist @relation(fields: [sourcePlaylistId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([sourcePlaylistId, startedAt])
}

// ---------------------------------------------------------------------------
// MUSIC-03 — playlist-inbox ingestion rules and audit history.
// ---------------------------------------------------------------------------

enum MusicIngestionRuleType {
  PLAYLIST_COPY
  SAVED_TRACK
  SAVED_TRACK_ALBUM
}

enum MusicIngestionInitialMode {
  FROM_NOW
  IMPORT_CURRENT
}

enum MusicIngestionCapabilityStatus {
  UNKNOWN
  SUPPORTED
  BLOCKED
}

enum MusicIngestionTrigger {
  INITIAL_BASELINE
  INITIAL_IMPORT
  USER_SYNC
  SCHEDULED
  MANUAL
}

enum MusicIngestionRunStatus {
  PREVIEW
  SUCCESS
  PARTIAL
  FAILED
  NOOP
}

model MusicIngestionRule {
  id                     String                         @id @default(cuid())
  userId                 String
  targetSourcePlaylistId String
  type                   MusicIngestionRuleType
  sourceSpotifyId        String?
  sourceName             String?
  enabled                Boolean                        @default(false)
  initialMode            MusicIngestionInitialMode      @default(FROM_NOW)
  state                  Json?
  capabilityStatus       MusicIngestionCapabilityStatus @default(UNKNOWN)
  capabilityMessage      String?                        @db.Text
  lastSyncAt             DateTime?
  lastSuccessAt          DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  target SourcePlaylist      @relation("MusicIngestionTarget", fields: [targetSourcePlaylistId], references: [id], onDelete: Cascade)
  runs   MusicIngestionRun[]

  @@index([userId, enabled])
  @@index([targetSourcePlaylistId])
}

model MusicIngestionRun {
  id                     String                  @id @default(cuid())
  userId                 String
  ruleId                 String?
  targetSourcePlaylistId String
  ruleType               MusicIngestionRuleType?
  trigger                MusicIngestionTrigger
  status                 MusicIngestionRunStatus
  preview                Boolean                 @default(false)
  sourceEventCount       Int                     @default(0)
  addedCount             Int                     @default(0)
  duplicateCount         Int                     @default(0)
  cooldownCount          Int                     @default(0)
  unavailableCount       Int                     @default(0)
  details                Json?
  startedAt              DateTime                @default(now())
  finishedAt             DateTime?
  error                  String?                 @db.Text

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule   MusicIngestionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  target SourcePlaylist      @relation("MusicIngestionRunTarget", fields: [targetSourcePlaylistId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([ruleId, startedAt])
  @@index([targetSourcePlaylistId, startedAt])
}

// ---------------------------------------------------------------------------
// Native music listening history — MUSIC-01 / HISTORY-01
// ---------------------------------------------------------------------------

enum MusicRepeatWindowUnit {
  DAYS
  MONTHS
  YEARS
}

enum ListeningEventSource {
  SPOTIFY_RECENTLY_PLAYED
  SPOTIFY_EXTENDED_HISTORY
  LASTFM_SCROBBLE
  IMPORT
}

enum LastFmBackfillStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum SpotifyExtendedHistoryImportStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model MusicPlaybackPolicy {
  id                String                 @id @default(cuid())
  userId            String                 @unique
  enabled           Boolean                @default(false)
  windowValue       Int?
  windowUnit        MusicRepeatWindowUnit?
  historyKnownSince DateTime?
  lastSyncAt        DateTime?
  syncAfterCursor   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrackListeningState {
  id             String   @id @default(cuid())
  userId         String
  spotifyTrackId String
  spotifyUri     String?
  lastPlayedAt   DateTime
  firstSeenAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyTrackId])
  @@index([userId, lastPlayedAt])
}

model TrackListeningEvent {
  id              String               @id @default(cuid())
  userId          String
  spotifyTrackId  String?
  spotifyUri      String?
  trackName       String
  artistName      String
  primaryArtistId String?
  albumName       String?
  albumId         String?
  isrc            String?
  trackMbid       String?
  artistMbid      String?
  albumMbid       String?
  playedAt        DateTime
  source          ListeningEventSource
  sourceEventKey  String
  contextType     String?
  contextUri      String?
  metadata        Json?
  createdAt       DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceEventKey])
  @@index([userId, playedAt])
  @@index([userId, spotifyTrackId, playedAt])
  @@index([userId, artistName, trackName, playedAt])
}

model LastFmBackfillRun {
  id                  String               @id @default(cuid())
  userId              String
  username            String
  status              LastFmBackfillStatus @default(RUNNING)
  from                 DateTime?
  to                   DateTime
  nextPage             Int                 @default(1)
  totalPages           Int?
  profilePlayCount     Int?
  scannedProviderRows Int                  @default(0)
  acceptedEvents      Int                  @default(0)
  insertedEvents      Int                  @default(0)
  duplicateEvents     Int                  @default(0)
  nowPlayingSkipped   Int                  @default(0)
  invalidSkipped      Int                  @default(0)
  startedAt           DateTime             @default(now())
  lastPageAt          DateTime?
  finishedAt          DateTime?
  error                String?              @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, username, status])
}

model SpotifyExtendedHistoryImportRun {
  id                String                              @id @default(cuid())
  userId            String
  packageSha256     String
  planHash          String
  planVersion       Int                                 @default(1)
  status             SpotifyExtendedHistoryImportStatus @default(RUNNING)
  uniqueMusicEvents Int
  insertPlanned     Int
  enrichPlanned     Int
  quarantinePlanned Int
  insertedEvents    Int                                 @default(0)
  enrichedEvents    Int                                 @default(0)
  duplicateEvents   Int                                 @default(0)
  noopEvents        Int                                 @default(0)
  startedAt         DateTime                            @default(now())
  finishedAt        DateTime?
  error              String?                            @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, packageSha256, planHash])
}

// ---------------------------------------------------------------------------
// ALBUM-01 — persistent album recommendation lifecycle memory.
// Exact Spotify album editions are keyed by spotifyAlbumId.
// ---------------------------------------------------------------------------

enum AlbumRecommendationState {
  DISCOVERED
  RECOMMENDED
  QUEUED
  LISTENING
  COMPLETED
  DISMISSED
}

model AlbumRecommendationMemory {
  id                       String                   @id @default(cuid())
  userId                   String
  spotifyAlbumId           String
  state                    AlbumRecommendationState
  artistName               String
  albumName                String
  queuedAt                 DateTime?
  queuedPlaylistId         String?
  queuedPlaylistName       String?
  queuedWriterSnapshot     String?
  queuedContentFingerprint String?
  source                   String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyAlbumId])
  @@index([userId, state, queuedAt])
}

// ---------------------------------------------------------------------------
// Native podcast listening state — PODCAST-04.
// ---------------------------------------------------------------------------

enum PodcastListeningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model EpisodeListeningState {
  id               String                 @id @default(cuid())
  userId           String
  spotifyEpisodeId String
  spotifyUri       String
  durationMs       Int
  resumePositionMs Int                    @default(0)
  fullyPlayed      Boolean                @default(false)
  status           PodcastListeningStatus @default(NOT_STARTED)
  lastObservedAt   DateTime
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyEpisodeId])
  @@index([userId, status])
  @@index([userId, lastObservedAt])
}

// ---------------------------------------------------------------------------
// Target playlists
// ---------------------------------------------------------------------------

enum DurationMode {
  FIXED
  CALENDAR
}

enum EmptyCalendarBehavior {
  CLEAR
  KEEP
  SKIP
}

enum CalendarEventFilterMode {
  ALL
  MARKER
}

enum CalendarDurationStrategy {
  SUMMED
  PER_EVENT
}

enum TargetCalendarMode {
  LEGACY_GLOBAL
  SELECTED
  ALL_QUERYABLE
}

enum PodcastEpisodeMaxDurationMode {
  NONE
  FIXED
  CALENDAR_MAX_EVENT
}

enum CompositionMode {
  PROPORTION
  SEQUENCE
}

enum MusicOrderMode {
  STANDARD
  RANDOMIZED
}

enum TargetDiscoveryIntensity {
  CONSERVATIVE
  BALANCED
  EXPLORATORY
}

enum TargetUpdatePolicy {
  MANUAL
  KEEP_FILLED
  REBUILD_DAILY
}

enum TargetScheduleRunStatus {
  RUNNING
  SUCCESS
  NOOP
  BLOCKED
  PARTIAL
  FAILED
}

model TargetPlaylist {
  id                               String                        @id @default(cuid())
  userId                           String
  name                             String
  spotifyPlaylistId                String?
  enabled                          Boolean                       @default(true)
  priority                         Int                           @default(0)
  compositionMode                  CompositionMode               @default(PROPORTION)
  musicOrderMode                   MusicOrderMode                @default(STANDARD)
  discoveryEnabled                 Boolean                       @default(false)
  discoveryFamiliarEnabled         Boolean                       @default(true)
  discoveryRediscoveryEnabled      Boolean                       @default(true)
  discoveryNoveltyEnabled          Boolean                       @default(true)
  discoveryReleasesEnabled         Boolean                       @default(true)
  discoveryIntensity               TargetDiscoveryIntensity      @default(BALANCED)
  durationMode                     DurationMode                  @default(FIXED)
  fixedDurationSeconds             Int?
  calendarMode                     TargetCalendarMode            @default(LEGACY_GLOBAL)
  emptyCalendarBehavior            EmptyCalendarBehavior         @default(CLEAR)
  calendarEventFilterMode          CalendarEventFilterMode       @default(ALL)
  calendarEventMarker              String?
  calendarDurationStrategy         CalendarDurationStrategy      @default(SUMMED)
  podcastPercent                   Int                           @default(60)
  podcastEpisodeMaxDurationMode    PodcastEpisodeMaxDurationMode @default(NONE)
  podcastEpisodeMaxDurationSeconds Int?
  sequencePattern                  Json
  maxEpisodesPerProgram            Int                           @default(1)
  maxTracksPerArtist               Int?
  maxTracksPerAlbum                Int?
  updatePolicy                     TargetUpdatePolicy            @default(MANUAL)
  dailyScheduleMinutes             Int?
  scheduleTimezone                 String?
  createdAt                        DateTime                       @default(now())
  updatedAt                        DateTime                       @updatedAt

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarSelections TargetPlaylistCalendar[]
  generationItems    GenerationItem[]
  targetScheduleRuns TargetScheduleRun[]

  @@index([userId, priority])
}

model TargetPlaylistCalendar {
  targetPlaylistId    String
  calendarSelectionId String
  createdAt           DateTime @default(now())

  targetPlaylist    TargetPlaylist    @relation(fields: [targetPlaylistId], references: [id], onDelete: Cascade)
  calendarSelection CalendarSelection @relation(fields: [calendarSelectionId], references: [id], onDelete: Cascade)

  @@id([targetPlaylistId, calendarSelectionId])
  @@index([calendarSelectionId])
}

// ---------------------------------------------------------------------------
// Generation runs
// ---------------------------------------------------------------------------

enum RunTrigger {
  MANUAL
  SCHEDULED
  SIMULATION
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model GenerationRun {
  id         String     @id @default(cuid())
  userId     String
  trigger    RunTrigger
  simulation Boolean    @default(false)
  status     RunStatus  @default(PENDING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  error      String?    @db.Text
  summary    Json?

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs             GenerationLog[]
  items            GenerationItem[]
  scheduleRuns     TargetScheduleRun[]     @relation("TargetScheduleRunGeneration")
  scheduleAttempts TargetScheduleAttempt[] @relation("TargetScheduleAttemptGeneration")

  @@index([userId, startedAt])
}

model GenerationLog {
  id        String   @id @default(cuid())
  runId     String
  level     LogLevel @default(INFO)
  message   String   @db.Text
  data      Json?
  createdAt DateTime @default(now())

  run GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

enum ContentType {
  MUSIC
  PODCAST
}

model GenerationItem {
  id                  String             @id @default(cuid())
  runId               String
  targetPlaylistId    String
  position            Int
  contentType         ContentType
  spotifyUri          String
  title               String?
  subtitle            String?
  programId           String?
  durationMs          Int                @default(0)
  spotifyTrackId      String?
  primaryArtistId     String?
  albumId             String?
  originalDurationMs  Int?
  resumePositionMs    Int?
  sourceSpotifyType   SpotifySourceType?
  sourceSpotifyId     String?
  sourceIncludePlayed Boolean?

  run    GenerationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  target TargetPlaylist @relation(fields: [targetPlaylistId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([targetPlaylistId])
}

// ---------------------------------------------------------------------------
// SOURCE-LIKED-01 — provider-neutral preference for native Sonoriza sources.
//
// Gate 5B1 only persists and exposes the user's desired source state. The
// planner intentionally does not consume this model until Gate 5B2, where the
// product preference will be combined with the operational rollout gate.
// ---------------------------------------------------------------------------

enum NativeSourceType {
  LIKED_TRACKS
}

model NativeSourcePreference {
  id        String           @id @default(cuid())
  userId    String
  type      NativeSourceType
  enabled   Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, enabled])
}

// ---------------------------------------------------------------------------
// LIKED-01 — canonical explicit liked-track state and artist affinity.
//
// Gate 2 is shadow-only: planner/discovery do not consume these models yet.
// A liked track is durable explicit preference evidence. Artist affinity is
// derived from the canonical primary artist and remains independently auditable
// so an unlike can remove one supporting track without erasing other evidence.
// ---------------------------------------------------------------------------

enum LikedTrackPreferenceProvenance {
  LIKED_TRACK_BACKFILL
  LIKED_TRACK_SYNC
}

enum LikedTrackAvailability {
  AVAILABLE
  UNAVAILABLE
  INVALID
}

enum ArtistAffinityEvidenceType {
  LIKED_TRACK
}

model LikedTrackPreference {
  id                String                         @id @default(cuid())
  userId            String
  spotifyTrackId    String
  spotifyUri        String?
  trackName         String?
  primaryArtistId   String?
  primaryArtistName String?
  albumId           String?
  albumName         String?
  durationMs        Int?
  addedAt           DateTime?
  isLiked           Boolean                        @default(true)
  availability      LikedTrackAvailability
  firstProvenance   LikedTrackPreferenceProvenance
  lastProvenance    LikedTrackPreferenceProvenance
  firstObservedAt   DateTime                       @default(now())
  lastObservedAt    DateTime
  unlikedAt         DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  affinityEvidence ArtistAffinityEvidence[]

  @@unique([userId, spotifyTrackId])
  @@index([userId, isLiked])
  @@index([userId, primaryArtistId, isLiked])
}

model ArtistAffinityEvidence {
  id                String                         @id @default(cuid())
  userId            String
  spotifyTrackId    String
  spotifyArtistId   String
  artistName        String?
  type              ArtistAffinityEvidenceType     @default(LIKED_TRACK)
  active            Boolean                        @default(true)
  firstProvenance   LikedTrackPreferenceProvenance
  lastProvenance    LikedTrackPreferenceProvenance
  firstObservedAt   DateTime                       @default(now())
  lastChangedAt     DateTime
  removedAt         DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  likedTrack LikedTrackPreference @relation(fields: [userId, spotifyTrackId], references: [userId, spotifyTrackId], onDelete: Cascade)

  @@unique([userId, type, spotifyTrackId, spotifyArtistId])
  @@index([userId, spotifyArtistId, active])
  @@index([userId, spotifyTrackId, active])
}

model ArtistAffinityState {
  id                String   @id @default(cuid())
  userId            String
  spotifyArtistId   String
  artistName        String?
  likedTrackCount   Int      @default(0)
  active            Boolean  @default(false)
  firstObservedAt   DateTime @default(now())
  lastChangedAt     DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyArtistId])
  @@index([userId, active, likedTrackCount])
}

// ---------------------------------------------------------------------------
// LIKED-01 Gate 3 — similar-artist expansion derived from explicit affinity.
//
// These rows remain shadow-only in Gate 3. Last.fm is the similarity provider;
// no planner/discovery consumer reads these models yet and no Spotify write is
// performed. A per-seed cache keeps provider load bounded and resumable.
// ---------------------------------------------------------------------------

enum ArtistSimilarityProvider {
  LASTFM
}

model ArtistSimilaritySeedState {
  id                    String                   @id @default(cuid())
  userId                String
  provider              ArtistSimilarityProvider
  sourceSpotifyArtistId String
  sourceArtistName      String
  active                Boolean                  @default(true)
  lastFetchedAt         DateTime?
  refreshAfter          DateTime?
  candidateCount        Int                      @default(0)
  lastError             String?                  @db.Text
  lastErrorAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  user  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  edges ArtistSimilarityEdge[]

  @@unique([userId, provider, sourceSpotifyArtistId])
  @@index([userId, provider, active, refreshAfter])
}

model ArtistSimilarityEdge {
  id                    String                   @id @default(cuid())
  userId                String
  seedStateId           String
  provider              ArtistSimilarityProvider
  sourceSpotifyArtistId String
  sourceArtistName      String
  candidateKey          String
  candidateArtistName   String
  candidateArtistMbid   String?
  candidateArtistUrl    String?                  @db.Text
  similarity            Float
  active                Boolean                  @default(true)
  firstObservedAt       DateTime                 @default(now())
  lastObservedAt        DateTime
  removedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seedState ArtistSimilaritySeedState @relation(fields: [seedStateId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, sourceSpotifyArtistId, candidateKey])
  @@index([userId, active, similarity])
  @@index([userId, candidateKey, active])
  @@index([seedStateId, active])
}

// ---------------------------------------------------------------------------
// MUSIC-05 — inferred skip preference signals.
//
// A signal separate from TrackListeningState. Persisting an INFERRED_SKIP never
// asserts a play: it is deliberately an inference derived from ORDER-01's
// published order plus MUSIC-01's canonical observed plays. The table is shaped
// so future signal types (and consumers like Tião Brain) can be added without
// turning TrackListeningState into a preference aggregate.
// ---------------------------------------------------------------------------

enum MusicPreferenceSignalType {
  INFERRED_SKIP
}

model MusicPreferenceSignal {
  id                    String                    @id @default(cuid())
  userId                String
  spotifyTrackId        String
  spotifyUri            String?
  type                  MusicPreferenceSignalType
  sourceGenerationRunId String
  targetPlaylistId      String
  generationItemId      String?
  position              Int
  confidence            Float                     @default(1)
  evidence              Json?
  inferredAt            DateTime                  @default(now())
  consumedAt            DateTime?
  consumedByRunId       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotency: re-analyzing the same generation/position never duplicates.
  @@unique([userId, type, sourceGenerationRunId, targetPlaylistId, position])
  @@index([userId, targetPlaylistId, type, consumedAt])
  @@index([userId, spotifyTrackId])
}

// ---------------------------------------------------------------------------
// SCHEDULE-01 — auditable recurring target maintenance.
// ---------------------------------------------------------------------------

model TargetScheduleRun {
  id                    String                  @id @default(cuid())
  userId                String
  targetPlaylistId      String
  scheduleKey           String                  @unique
  scheduledLocalDate    String
  scheduledForMinutes   Int
  scheduleTimezone      String
  policy                TargetUpdatePolicy
  status                TargetScheduleRunStatus @default(RUNNING)
  attempt               Int                     @default(1)
  generationRunId       String?
  targetDurationMs      Int?
  validDurationBeforeMs Int?
  removedDurationMs     Int                     @default(0)
  addedDurationMs       Int                     @default(0)
  preservedCount        Int                     @default(0)
  removedCount          Int                     @default(0)
  addedCount            Int                     @default(0)
  snapshotBefore        String?
  snapshotAfter         String?
  reason                String?                 @db.Text
  details               Json?
  startedAt             DateTime                @default(now())
  finishedAt            DateTime?

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  target        TargetPlaylist          @relation(fields: [targetPlaylistId], references: [id], onDelete: Cascade)
  generationRun GenerationRun?          @relation("TargetScheduleRunGeneration", fields: [generationRunId], references: [id], onDelete: SetNull)
  attempts      TargetScheduleAttempt[]

  @@index([userId, startedAt])
  @@index([targetPlaylistId, startedAt])
}

model TargetScheduleAttempt {
  id                  String                  @id @default(cuid())
  targetScheduleRunId String
  attempt             Int
  status              TargetScheduleRunStatus @default(RUNNING)
  generationRunId     String?
  reason              String?                 @db.Text
  details             Json?
  startedAt           DateTime                @default(now())
  finishedAt          DateTime?

  scheduleRun   TargetScheduleRun @relation(fields: [targetScheduleRunId], references: [id], onDelete: Cascade)
  generationRun GenerationRun?    @relation("TargetScheduleAttemptGeneration", fields: [generationRunId], references: [id], onDelete: SetNull)

  @@unique([targetScheduleRunId, attempt])
  @@index([targetScheduleRunId, startedAt])
  @@index([generationRunId])
}

// ---------------------------------------------------------------------------
// NOTIFY-01 — Web Push subscriptions, preferences and idempotent delivery.
// ---------------------------------------------------------------------------

enum NotificationCategory {
  GENERATION
  CLEANUP
  ERROR
  NOOP
}

enum PushDeliveryStatus {
  PENDING
  SENT
  FAILED
  STALE
  SUPPRESSED
}

model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  generationEnabled Boolean  @default(true)
  cleanupEnabled    Boolean  @default(true)
  errorEnabled      Boolean  @default(true)
  noopEnabled       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id                String    @id @default(cuid())
  userId            String
  endpointHash      String    @unique
  endpoint          String    @db.Text
  p256dh            String    @db.Text
  auth              String    @db.Text
  expirationTime    DateTime?
  enabled           Boolean   @default(true)
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  lastFailureStatus Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([userId, enabled])
}

model PushDelivery {
  id             String               @id @default(cuid())
  userId         String
  subscriptionId String
  eventKey       String
  category       NotificationCategory
  payload        Json
  status         PushDeliveryStatus   @default(PENDING)
  attemptCount   Int                  @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  lastError      String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventKey])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}
