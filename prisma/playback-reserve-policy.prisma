// ---------------------------------------------------------------------------
// PLAYBACK-RESERVE-01 — configuration + explicit plan-role persistence.
//
// Gate 1 introduced the policy contract with no planner influence. Gate 2 adds
// a canonical sidecar keyed by (run, target, position) so PRIMARY/RESERVE is
// stored explicitly rather than inferred from duration or position thresholds.
// Missing global policy is NONE. Missing target policy is INHERIT_GLOBAL.
//
// Gate 2 still does not alter planner selection/publication. Runtime gates may
// later persist RESERVE rows together with the effective policy snapshot.
// ---------------------------------------------------------------------------

enum PlaybackReserveMode {
  NONE
  DURATION
  MUSIC_TRACKS
  PODCAST_EPISODES
}

enum PlaybackReservePodcastMode {
  DISABLED
  IF_FITS
}

enum TargetPlaybackReservePolicyMode {
  INHERIT_GLOBAL
  OVERRIDE
}

enum GenerationPlanRole {
  PRIMARY
  RESERVE
}

model PlaybackReservePolicy {
  userId                   String                      @id
  reserveMode              PlaybackReserveMode         @default(NONE)
  durationSeconds          Int?
  musicTrackCount          Int?
  podcastEpisodeCount      Int?
  podcastInDurationReserve PlaybackReservePodcastMode   @default(DISABLED)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@index([reserveMode])
}

model TargetPlaybackReservePolicy {
  userId                   String
  targetPlaylistId         String
  policyMode               TargetPlaybackReservePolicyMode @default(INHERIT_GLOBAL)
  reserveMode              PlaybackReserveMode?
  durationSeconds          Int?
  musicTrackCount          Int?
  podcastEpisodeCount      Int?
  podcastInDurationReserve PlaybackReservePodcastMode?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  @@id([userId, targetPlaylistId])
  @@index([userId, policyMode])
}

model GenerationPlanItemRole {
  runId            String
  targetPlaylistId String
  position         Int
  role             GenerationPlanRole @default(PRIMARY)
  reservePolicy    Json?
  createdAt        DateTime           @default(now())

  @@id([runId, targetPlaylistId, position])
  @@index([runId, targetPlaylistId, role])
}
