// ---------------------------------------------------------------------------
// CALENDAR-03 Gate 1 — canonical per-target event composition policy.
//
// This model is deliberately separate from TargetPlaylist so Gate 1 can land
// persistence and validation without changing the planner contract. Absence of
// a row is equivalent to the backward-compatible defaults exposed by the
// service contract.
// ---------------------------------------------------------------------------

enum EventCompositionPolicy {
  INHERIT_DESTINATION
  PODCAST_THEN_MUSIC
  // CALENDAR-04 (#532): restart the target sequence at every event, then fill
  // the remaining event time with remainderFillStrategy.
  SEQUENCE_PER_EVENT
}

enum CalendarRemainderFillStrategy {
  MUSIC_ONLY
  PODCAST_ONLY
  MIX_RATIO
  REPEAT_SEQUENCE
}

enum CalendarRemainderFallback {
  FILL_WITH_MUSIC
  LEAVE_GAP
}

enum PodcastEventDistribution {
  EVERY_EVENT
  EVERY_N_EVENTS
}

model CalendarEventCompositionPolicy {
  userId                          String
  targetPlaylistId                String
  eventCompositionPolicy          EventCompositionPolicy  @default(INHERIT_DESTINATION)
  maxPodcastsPerEvent             Int                     @default(1)
  podcastEventSafetyMarginSeconds Int                     @default(0)
  podcastEventDistribution        PodcastEventDistribution @default(EVERY_EVENT)
  podcastEveryNEvents             Int                     @default(1)
  podcastEventOffset              Int                     @default(0)
  remainderFillStrategy           CalendarRemainderFillStrategy @default(MUSIC_ONLY)
  remainderPodcastPercent         Int                     @default(30)
  remainderFallback               CalendarRemainderFallback @default(FILL_WITH_MUSIC)
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt

  @@id([userId, targetPlaylistId])
  @@index([userId, eventCompositionPolicy])
}
